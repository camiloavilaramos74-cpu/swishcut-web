{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)\\.(html|css|js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)\\.(mp4|webp|png|svg)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ]
}